% Sorts in the size vectors: [$i]
% Detected minimum model sizes of [1]
% Detected maximum model sizes of [5]
% TRYING [1]
% TRYING [2]
% Finite Model Found!
% SZS status Satisfiable for version-name-clash
% FMB model self-check passed (7 units checked)
% SZS output start FiniteModel for version-name-clash
tff('declare_$i1',type,'fmb_$i_1':$i).
tff('declare_$i2',type,'fmb_$i_2':$i).
tff('finite_domain_$i',axiom,
      ! [X:$i] : (
         (X = 'fmb_$i_1') | (X = 'fmb_$i_2')
      ) ).

tff('distinct_domain_$i',axiom,
         'fmb_$i_1' != 'fmb_$i_2'
).

tff(declare_a,type,a : $i).
tff(declare_c,type,c : $i).
tff(declare_d,type,d : $i).
tff(declare_b,type,b : $i).
tff(declare_e,type,e : $i).
tff(declare_x,type,x: ( $i ) > $o ).
tff(declare_r,type,r: ( $i ) > $o ).
tff(declare_s,type,s: ( $i ) > $o ).
tff('declare_x_$1',type,'x_$1': ( $i ) > $o ).
tff('declare_x__$1',type,'x__$1': ( $i ) > $o ).
tff('declare_x___$1',type,'x___$1': ( $i ) > $o ).

tff(a_definition,axiom,a = 'fmb_$i_1').
tff(c_definition,axiom,c = 'fmb_$i_1').
tff(d_definition,axiom,d = 'fmb_$i_1').
tff(b_definition,axiom,b = 'fmb_$i_2').
tff(e_definition,axiom,e = 'fmb_$i_2').
tff(predicate_x,axiom,
           x('fmb_$i_1')
         & ~x('fmb_$i_2')
).

tff(r_symbolic_definition,axiom,![X0:$i]: (r(X0) <=> (? [X1:$i] : ('x___$1'(X1) & (X0 = X1))))).
tff(s_symbolic_definition,axiom,![X0:$i]: (s(X0) <=> (? [X1:$i] : ('x___$1'(X1) & (X0 = X1))))).
tff('x_$1_symbolic_definition',axiom,![X0:$i]: ('x_$1'(X0) <=> $true)).
tff('x__$1_symbolic_definition',axiom,![X0:$i]: ('x__$1'(X0) <=> $false)).
tff('x___$1_symbolic_definition',axiom,![X0:$i]: ('x___$1'(X0) <=> ((d = X0) | (a = X0) | (c = X0)))).
% SZS output end FiniteModel for version-name-clash
