% Detected minimum model sizes of [1,1]
% Detected maximum model sizes of [2,2]
% TRYING [1,1]
% TRYING [1,2]
% TRYING [2,2]
% Finite Model Found!
% SZS status Satisfiable for sortelim
% FMB model self-check passed (5 units checked)
% SZS output start FiniteModel for sortelim
tff('declare_$i1',type,'fmb_$i_1':$i).
tff('finite_domain_$i',axiom,
      ! [X:$i] : (
         X = 'fmb_$i_1'
      ) ).

tff(declare_s,type,s:$tType).
tff(declare_s1,type,fmb_s_1:s).
tff(declare_s2,type,fmb_s_2:s).
tff(finite_domain_s,axiom,
      ! [X:s] : (
         X = fmb_s_1 | X = fmb_s_2
      ) ).

tff(distinct_domain_s,axiom,
         fmb_s_1 != fmb_s_2
).

tff(declare_t,type,t:$tType).
tff(declare_t1,type,fmb_t_1:t).
tff(declare_t2,type,fmb_t_2:t).
tff(finite_domain_t,axiom,
      ! [X:t] : (
         X = fmb_t_1 | X = fmb_t_2
      ) ).

tff(distinct_domain_t,axiom,
         fmb_t_1 != fmb_t_2
).

tff(declare_c,type,c : s).
tff(c_definition,axiom,c = fmb_s_1).
tff(declare_d1,type,d1 : t).
tff(d1_definition,axiom,d1 = fmb_t_1).
tff(declare_d2,type,d2 : t).
tff(d2_definition,axiom,d2 = fmb_t_2).
tff(declare_f,type,f : ( s ) > s).
tff(f_symbolic_definition,axiom,![X0:s]: f(X0) = fmb_s_1).
tff(declare_p,type,p: ( s ) > $o ).
tff(predicate_p,axiom,
           p(fmb_s_1)
         & ~p(fmb_s_2)
).

tff(declare_q,type,q: ( s ) > $o ).
tff(predicate_q,axiom,
           q(fmb_s_1)
         & q(fmb_s_2)
).

tff(declare_r,type,r: ( t ) > $o ).
tff(predicate_r,axiom,
           r(fmb_t_1)
         & ~r(fmb_t_2)
).

% SZS output end FiniteModel for sortelim
